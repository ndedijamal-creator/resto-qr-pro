# ================================
# RESTO QR PRO — Variables d'environnement (Backend)
# Copier ce fichier en ".env" et renseigner les vraies valeurs
# ================================

# Serveur
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=resto_qr_pro

# JWT
JWT_SECRET=change_this_super_secret_key_in_production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_this_other_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# URL publique utilisée pour générer les QR Codes (restaurant.com/table/:code)
PUBLIC_APP_URL=https://restaurant.com

# Email (réinitialisation de mot de passe)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=changeme
